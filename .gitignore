# Dados (nunca versionar dados brutos ou amostras pesadas)
data/raw/*
data/sample/*
!data/raw/.gitkeep
!data/sample/.gitkeep
*.dcm

# Saídas geradas (reprodutíveis a partir do código)
outputs/*
!outputs/tables/
!outputs/figures/
!outputs/models/
outputs/tables/*
outputs/figures/*
outputs/models/*
!outputs/.gitkeep
!outputs/tables/.gitkeep
!outputs/figures/.gitkeep
!outputs/models/.gitkeep

